{
  "compilerOptions": {
    "target": "ES2021",
    "lib": [
      "ES2021",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@episode": [
        "episodes/_demo/index.ts"
      ],
      "@stage": [
        "src/stage/api.ts"
      ]
    }
  },
  "include": [
    "src",
    "scripts",
    "remotion.config.ts",
    "episodes/_demo",
    "site"
  ]
}
